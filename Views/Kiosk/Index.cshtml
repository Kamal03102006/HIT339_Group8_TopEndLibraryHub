@model IEnumerable<TopEndLibraryHub.Models.Item>
@using TopEndLibraryHub.Models

@{
    ViewData["Title"] = "Self-Service Library Kiosk";

    var search = ViewBag.Search as string ?? "";
    var status = ViewBag.Status as string ?? "";
    var type = ViewBag.Type as string ?? "";
}

<link rel="stylesheet"
      href="~/css/kiosk.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/kiosk-additions.css"
      asp-append-version="true" />

<main class="kiosk">

    <header class="kiosk-hero">

        <span class="kiosk-eyebrow">
            TOP END LIBRARY HUB
        </span>

        <h1>Welcome to Your Library</h1>

        <p>
            Search the catalogue, scan library items,
            and manage your borrowing account.
        </p>

        <nav class="kiosk-actions">

            <a asp-controller="Kiosk"
               asp-action="Scan"
               class="kiosk-button">
                Scan Library Item
            </a>

            <a asp-controller="Kiosk"
               asp-action="Account"
               class="kiosk-button">
                My Library Account
            </a>

        </nav>

    </header>

    <section class="kiosk-search-section">

        <h2>Search Library Catalogue</h2>

        <form method="get"
              asp-controller="Kiosk"
              asp-action="Index">

            <div class="kiosk-field">

                <label for="search">Search Items</label>

                <input type="search"
                       id="search"
                       name="search"
                       value="@search"
                       maxlength="100"
                       placeholder="Title, code or keyword" />

            </div>

            <div class="kiosk-field">

                <label for="type">Category</label>

                <select id="type" name="type">
                    <option value="">All Categories</option>
                    <option value="Book" selected="@(type == "Book")">
                        Books
                    </option>
                    <option value="Music" selected="@(type == "Music")">
                        Music
                    </option>
                    <option value="Toy" selected="@(type == "Toy")">
                        Toys
                    </option>
                </select>

            </div>

            <div class="kiosk-field">

                <label for="status">Item Status</label>

                <select id="status" name="status">
                    <option value="">All Statuses</option>
                    <option value="Available"
                            selected="@(status == "Available")">
                        Available
                    </option>
                    <option value="Borrowed"
                            selected="@(status == "Borrowed")">
                        Borrowed
                    </option>
                    <option value="Damaged"
                            selected="@(status == "Damaged")">
                        Damaged
                    </option>
                    <option value="Destroyed"
                            selected="@(status == "Destroyed")">
                        Destroyed
                    </option>
                </select>

            </div>

            <button type="submit" class="kiosk-button">
                Search Catalogue
            </button>

            <a asp-action="Index" class="kiosk-clear">
                Clear Filters
            </a>

        </form>

    </section>

    <section class="kiosk-results">

        <h2>Library Catalogue</h2>

        <p>@Model.Count() items displayed</p>

        @if (!Model.Any())
        {
            <p>No items found. Try another search.</p>
        }
        else
        {
            <div class="kiosk-grid">

                @foreach (var item in Model)
                {
                    var available =
                        item.Status == ItemStatus.Available;

                    var category =
                        item is Book ? "Book" :
                        item is Toy ? "Toy" :
                        item is Music ? "Music" :
                        "Library Item";

                    <article class="kiosk-card">

                        <div class="kiosk-card-top">

                            <span class="kiosk-type">
                                @category
                            </span>

                            <span class="kiosk-status
                                @(available ? "is-available" : "is-unavailable")">
                                @item.Status
                            </span>

                        </div>

                        <h3>@item.Name</h3>

                        <p>@item.Description</p>

                        <p>
                            <strong>Library Code:</strong>
                            @item.LibraryCode
                        </p>

                        @if (available)
                        {
                            <p class="available-message">
                                Listed as available.
                                Checkout eligibility is checked when borrowing.
                            </p>
                        }
                        else
                        {
                            <p class="unavailable-message">
                                Not currently available.
                            </p>
                        }

                    </article>
                }

            </div>
        }

    </section>

    <aside class="kiosk-help">

        <h2>Need Assistance?</h2>

        <p>
            Select Scan Library Item to enter
            or scan an item code.
        </p>

        <p>
            Sign in to access your membership
            and request self-service checkout.
        </p>

        <p>
            Some items may require staff assistance
            because of reservations or transfers.
        </p>

    </aside>

</main>
@await Html.PartialAsync("_KioskIdle")