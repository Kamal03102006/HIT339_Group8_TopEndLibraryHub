
@model TopEndLibraryHub.Models.Item
@using TopEndLibraryHub.Models

@{
    ViewData["Title"] = "Scan Library Item";
}

<link rel="stylesheet"
      href="~/css/kiosk.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/kiosk-additions.css"
      asp-append-version="true" />

<main class="kiosk kiosk-journey">

    <header class="kiosk-hero">
        <h1>Scan Library Item</h1>
        <p>
            Enter or scan the library code to find
            an item and request checkout.
        </p>
    </header>

    <section class="kiosk-search-section">

        <h2>Find an Item</h2>

        @if (TempData["KioskError"] != null)
        {
            <div class="kiosk-alert"
                 role="alert"
                 style="padding:16px; margin:16px 0;
                        border:2px solid #b42318;
                        border-radius:8px;">
                <strong>Checkout could not be completed</strong>
                <p>@TempData["KioskError"]</p>
            </div>
        }

        @if (ViewBag.Message != null)
        {
            <div class="kiosk-alert" role="alert">
                <p>@ViewBag.Message</p>
            </div>
        }

        <form asp-controller="Kiosk"
              asp-action="Scan"
              method="post">

            @Html.AntiForgeryToken()

            <label for="libraryCode">
                Library Code
            </label>

            <input id="libraryCode"
                   name="libraryCode"
                   value="@(Model?.LibraryCode ?? "")"
                   maxlength="20"
                   autocomplete="off"
                   placeholder="BK-0001"
                   required />

            <button class="kiosk-button"
                    type="submit">
                Find Item
            </button>
        </form>

    </section>

    @if (Model != null)
    {
        <section class="kiosk-search-section">

            <h2>@Model.Name</h2>

            <p>@Model.Description</p>

            <p>
                <strong>Library Code:</strong>
                @Model.LibraryCode
            </p>

            <p>
                <strong>Item Status:</strong>
                @Model.Status
            </p>

            @if (Model.Status == ItemStatus.Available)
            {
                <p>
                    This item is listed as available.
                    Your membership, holds, branch and
                    transfer restrictions will be checked
                    before checkout.
                </p>

                <form asp-controller="Kiosk"
                      asp-action="Checkout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="libraryCode"
                           value="@Model.LibraryCode" />

                    <button type="submit"
                            class="kiosk-button">
                        Request Checkout
                    </button>
                </form>
            }
            else
            {
                <p class="kiosk-alert">
                    This item is not currently available
                    for checkout.
                </p>
            }

        </section>
    }

    <nav class="kiosk-actions">

        <a asp-controller="Kiosk"
           asp-action="Account"
           class="kiosk-button">
            My Library Account
        </a>

        <a asp-controller="Kiosk"
           asp-action="Index"
           class="kiosk-button">
            Back to Catalogue
        </a>

        <form asp-controller="Kiosk"
              asp-action="Finish"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="kiosk-button">
                Finish Session / Sign Out
            </button>
        </form>

    </nav>

</main>

@await Html.PartialAsync("_KioskIdle")