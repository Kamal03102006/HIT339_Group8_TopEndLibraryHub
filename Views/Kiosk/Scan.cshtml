@model TopEndLibraryHub.Models.Item
@using TopEndLibraryHub.Models
@{ ViewData["Title"] = "Scan Item"; }
<link rel="stylesheet" href="~/css/kiosk.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/kiosk-additions.css" asp-append-version="true" />
<main class="kiosk kiosk-journey">
<header class="kiosk-hero"><h1>Scan Library Item</h1><p>Scan a barcode or enter a library code and press Enter.</p></header>
<section class="kiosk-search-section"><form asp-controller="Kiosk" asp-action="Scan" method="post">
@Html.AntiForgeryToken()<label for="libraryCode">Library code</label>
<input id="libraryCode" name="libraryCode" autocomplete="off" maxlength="20" placeholder="BK-0001" autofocus required />
<button class="kiosk-button" type="submit">Find Item</button></form>
@if (ViewBag.Message != null) { <p class="kiosk-alert" role="alert">@ViewBag.Message</p> }
</section>
@if (Model != null) { <section class="kiosk-search-section"><h2>@Model.Name</h2><p>@Model.Description</p><p><strong>Code:</strong> @Model.LibraryCode</p><p><strong>Status:</strong> @Model.Status</p>
@if (Model.Status == ItemStatus.Available) {
<p>Catalogue status: available. Checkout additionally requires approved borrowing checks.</p>
<form asp-controller="Kiosk" asp-action="Checkout" method="post">@Html.AntiForgeryToken()
<input type="hidden" name="libraryCode" value="@Model.LibraryCode" />
<button class="kiosk-button" type="submit">Request Checkout</button></form>
} else { <p class="kiosk-alert">This item is unavailable.</p> }
</section> }
<nav class="kiosk-actions"><a asp-controller="Kiosk" asp-action="Account" class="kiosk-button">My Account</a>
<form asp-controller="Kiosk" asp-action="Finish" method="post">@Html.AntiForgeryToken()<button type="submit" class="kiosk-button">Finish Session / Sign Out</button></form></nav>
</main>
