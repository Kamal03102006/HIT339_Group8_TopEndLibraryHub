@model TopEndLibraryHub.ViewModels.CreateHoldViewModel

@{
    ViewData["Title"] = "Place a hold";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <h1 class="display-6 fw-semibold mb-2">Place a hold</h1>
        <p class="text-muted mb-4">
            Join the waiting list for an item on loan or awaiting repair.
            Choose the branch where the member will collect it.
        </p>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-controller="Holds" asp-action="Create" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"
                         role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="LibraryCode" class="form-label"></label>
                        <input asp-for="LibraryCode"
                               class="form-control form-control-lg"
                               placeholder="BK-0001 or TY-0001"
                               maxlength="20" autocomplete="off"
                               spellcheck="false" autofocus
                               aria-describedby="item-code-help" />
                        <span asp-validation-for="LibraryCode"
                              class="text-danger"></span>
                        <div id="item-code-help" class="form-text">
                            Scan the item's barcode or type its library code.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MembershipNumber" class="form-label"></label>
                        <input asp-for="MembershipNumber"
                               class="form-control form-control-lg"
                               placeholder="MBR-0001"
                               maxlength="20" autocomplete="off"
                               spellcheck="false" />
                        <span asp-validation-for="MembershipNumber"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PickupBranchId" class="form-label"></label>
                        <select asp-for="PickupBranchId"
                                asp-items="Model.PickupBranches"
                                class="form-select form-select-lg">
                            <option value="">Choose a pickup branch</option>
                        </select>
                        <span asp-validation-for="PickupBranchId"
                              class="text-danger"></span>
                    </div>

                    <div class="alert alert-info">
                        <strong>First come, first served.</strong>
                        Requests keep their original order while an item is
                        on loan or awaiting repair. Pickup notification follows
                        when the item is ready at the chosen branch.
                    </div>

                    <div class="d-flex flex-column flex-sm-row gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">
                            Join waiting list
                        </button>
                        <a asp-controller="Holds" asp-action="Index"
                           class="btn btn-outline-secondary btn-lg">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
