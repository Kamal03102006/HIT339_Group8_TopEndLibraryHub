@model TopEndLibraryHub.ViewModels.HoldListViewModel

@{
    ViewData["Title"] = "Holds and waitlist";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="display-6 fw-semibold mb-2">Holds and waitlist</h1>
        <p class="text-muted mb-0">Help members wait fairly for an item on loan or awaiting repair.</p>
    </div>
    <a class="btn btn-primary btn-lg" asp-action="Create">Place a hold</a>
</div>

@if (TempData["HoldSuccess"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
@if (TempData["HoldError"] is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}
<div asp-validation-summary="All" class="text-danger" role="alert"></div>

<form method="get" asp-action="Index" class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-lg-6">
                <label for="hold-search" class="form-label">Member, item code or title</label>
                <input id="hold-search" name="search" value="@Model.Search" maxlength="100"
                       class="form-control" placeholder="MBR-0002 or TY-0001" />
            </div>
            <div class="col-lg-3">
                <label for="hold-status" class="form-label">Request status</label>
                <select id="hold-status" name="status" class="form-select">
                    <option value="">All statuses</option>
                    @foreach (var option in Enum.GetValues<HoldStatus>())
                    {
                        var label = option switch
                        {
                            HoldStatus.ReadyForPickup => "Ready for pickup",
                            HoldStatus.Fulfilled => "Collected",
                            _ => option.ToString()
                        };
                        <option value="@option" selected="@(Model.Status == option ? "selected" : null)">@label</option>
                    }
                </select>
            </div>
            <div class="col-lg-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Filter requests</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </div>
    </div>
</form>

<div class="alert alert-info">
    <strong>Queue order stays fair.</strong> Eligible waiting requests are ordered by their
    original creation time, then request number. An inactive membership or pickup branch
    pauses eligibility. A queue position does not mean the item is ready for collection.
</div>

<p class="text-muted">@Model.TotalCount matching request(s). Newest requests are displayed first; queue positions follow the original waiting order.</p>

@if (Model.Rows.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <h2 class="h4">No matching requests</h2>
            <p class="mb-0">Try another filter, or place a hold for a member waiting for a borrowed or damaged item.</p>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var row in Model.Rows)
        {
            <div class="col-12">
                <article class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex flex-column flex-md-row justify-content-between gap-3">
                            <div>
                                <span class="badge text-bg-secondary mb-2">@row.StatusLabel</span>
                                <h2 class="h4 mb-1">@row.ItemName</h2>
                                <p class="text-muted mb-2">@row.LibraryCode · Request #@row.Id</p>
                                <p class="mb-1"><strong>@row.MembershipNumber</strong> · @row.MemberName</p>
                                <p class="mb-0">Pickup: <strong>@row.PickupBranchName</strong></p>
                            </div>
                            <div class="text-md-end">
                                @if (row.QueuePosition.HasValue)
                                {
                                    <p class="mb-1">Waiting-list position <strong class="fs-4">@row.QueuePosition</strong></p>
                                }
                                <p class="small text-muted mb-0">Requested @row.CreatedAtDarwin.ToString("dd MMM yyyy, h:mm tt") ACST</p>
                            </div>
                        </div>
                        <p class="mt-3 mb-0">@row.NextStep</p>
                        @if (row.CanCancel)
                        {
                            <form asp-action="Cancel" method="post" class="mt-3">
                                <input type="hidden" name="id" value="@row.Id" />
                                <button type="submit" class="btn btn-outline-danger">Cancel waiting request</button>
                            </form>
                        }
                    </div>
                </article>
            </div>
        }
    </div>
}

@if (Model.PageCount > 1)
{
    <nav aria-label="Hold request pages" class="d-flex align-items-center justify-content-between gap-3 mt-4">
        @if (Model.Page > 1)
        {
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-search="@Model.Search"
               asp-route-status="@Model.Status" asp-route-page="@(Model.Page - 1)">Previous</a>
        }
        else
        {
            <span></span>
        }
        <span>Page @Model.Page of @Model.PageCount</span>
        @if (Model.Page < Model.PageCount)
        {
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-search="@Model.Search"
               asp-route-status="@Model.Status" asp-route-page="@(Model.Page + 1)">Next</a>
        }
        else
        {
            <span></span>
        }
    </nav>
}
