@model TopEndLibraryHub.ViewModels.StaffLocationViewModel

@{
    ViewData["Title"] = "Working location";
}

<h1>Working location</h1>

<p>Select the branch and reception desk you are working from.</p>

@if (TempData["LocationMessage"] is string message)
{
    <div class="alert alert-success" role="status">
        @message
    </div>
}

@if (!string.IsNullOrEmpty(Model.CurrentLocation))
{
    <p>
        <strong>Current location:</strong>
        @Model.CurrentLocation
    </p>
}
else
{
    <p>No working location selected.</p>
}

<form asp-controller="StaffLocation"
      asp-action="Index"
      method="post">

    <div asp-validation-summary="All"
         class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="BranchId" class="form-label"></label>
        <select asp-for="BranchId"
                asp-items="Model.Branches"
                class="form-select">
            <option value="">Select a branch</option>
        </select>
        <span asp-validation-for="BranchId"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ReceptionDeskId"
               class="form-label"></label>
        <select asp-for="ReceptionDeskId"
                asp-items="Model.Desks"
                class="form-select">
            <option value="">Select a reception desk</option>
        </select>
        <span asp-validation-for="ReceptionDeskId"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Save working location
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}