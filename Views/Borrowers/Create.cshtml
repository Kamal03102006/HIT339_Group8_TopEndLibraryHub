@model TopEndLibraryHub.Models.Borrower

@{
    ViewData["Title"] = "Register borrower";
}

<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
            <div>
                <h1 class="display-6 fw-semibold mb-1">Register borrower</h1>
                <p class="text-muted mb-0">
                    Create a borrower account for front-desk services.
                </p>
            </div>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Back to borrowers
            </a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-5">
                            <label asp-for="MembershipNumber"
                                   class="form-label"></label>
                            <input asp-for="MembershipNumber"
                                   class="form-control text-uppercase"
                                   placeholder="MBR-0002" />
                            <span asp-validation-for="MembershipNumber"
                                  class="text-danger"></span>
                            <div class="form-text">
                                Enter a unique membership number.
                            </div>
                        </div>

                        <div class="col-md-7">
                            <label asp-for="FullName"
                                   class="form-label"></label>
                            <input asp-for="FullName"
                                   class="form-control"
                                   autocomplete="name"
                                   placeholder="Borrower’s full name" />
                            <span asp-validation-for="FullName"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-7">
                            <label asp-for="Email"
                                   class="form-label"></label>
                            <input asp-for="Email"
                                   class="form-control"
                                   autocomplete="email"
                                   placeholder="name@example.com" />
                            <span asp-validation-for="Email"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-5">
                            <label asp-for="Phone"
                                   class="form-label"></label>
                            <input asp-for="Phone"
                                   class="form-control"
                                   type="tel"
                                   autocomplete="tel"
                                   placeholder="0412 345 678" />
                            <span asp-validation-for="Phone"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Address"
                                   class="form-label"></label>
                            <textarea asp-for="Address"
                                      class="form-control"
                                      rows="3"
                                      autocomplete="street-address"
                                      placeholder="Residential address"></textarea>
                            <span asp-validation-for="Address"
                                  class="text-danger"></span>
                        </div>
                    </div>

                    <div class="alert alert-info mt-4 mb-0">
                        The registration date is recorded automatically and
                        the new borrower will be activated immediately.
                    </div>

                    <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            Register borrower
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}