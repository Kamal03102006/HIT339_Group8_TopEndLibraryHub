@model TopEndLibraryHub.Models.Toy
@using TopEndLibraryHub.Models

@{
    ViewData["Title"] = "Toy details";

    var statusClass = Model.Status switch
    {
        ItemStatus.Available => "bg-success",
        ItemStatus.Borrowed => "bg-primary",
        ItemStatus.Damaged => "bg-warning text-dark",
        ItemStatus.Destroyed => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-4">
                    <div>
                        <h1 class="display-6 fw-semibold mb-1">@Model.Name</h1>
                        <p class="text-muted mb-0">
                            Complete toy and catalogue information
                        </p>
                    </div>

                    <div>
                        <span class="badge @statusClass fs-6">
                            @Model.Status
                        </span>
                    </div>
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-4 col-lg-3">Library code</dt>
                    <dd class="col-sm-8 col-lg-9">@Model.LibraryCode</dd>

                    <dt class="col-sm-4 col-lg-3">Toy type</dt>
                    <dd class="col-sm-8 col-lg-9">@Model.ToyType</dd>

                    <dt class="col-sm-4 col-lg-3">Recommended age</dt>
                    <dd class="col-sm-8 col-lg-9">@Model.RecommendedAge</dd>

                    <dt class="col-sm-4 col-lg-3">Manufacturer</dt>
                    <dd class="col-sm-8 col-lg-9">@Model.Manufacturer</dd>

                    <dt class="col-sm-4 col-lg-3">Material</dt>
                    <dd class="col-sm-8 col-lg-9">@Model.Material</dd>

                    <dt class="col-sm-4 col-lg-3">Date added</dt>
                    <dd class="col-sm-8 col-lg-9">
                        @Model.DateAdded.ToString("dd MMMM yyyy")
                    </dd>

                    <dt class="col-sm-4 col-lg-3">Description</dt>
                    <dd class="col-sm-8 col-lg-9">@Model.Description</dd>
                </dl>

                <div class="d-flex flex-column flex-sm-row justify-content-between gap-3 mt-4">
                    <div class="d-flex gap-2">
                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-primary">
                            Edit toy
                        </a>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Back to toys
                        </a>
                    </div>

                    <a asp-action="Delete"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-danger">
                        Delete
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>