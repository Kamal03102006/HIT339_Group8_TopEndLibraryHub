@model TopEndLibraryHub.Models.Toy

@{
    ViewData["Title"] = "Add toy";
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
            <div>
                <h1 class="display-6 fw-semibold mb-1">Add toy</h1>
                <p class="text-muted mb-0">
                    Add a new toy to the library catalogue.
                </p>
            </div>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Back to toys
            </a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert"></div>

                    <h2 class="h5 mb-3">Catalogue information</h2>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="LibraryCode" class="form-label"></label>
                            <input asp-for="LibraryCode"
                                   class="form-control text-uppercase"
                                   placeholder="TY-0002" />
                            <span asp-validation-for="LibraryCode"
                                  class="text-danger"></span>
                            <div class="form-text">
                                Use 2-4 capital letters followed by four numbers.
                            </div>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter the toy name" />
                            <span asp-validation-for="Name"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Describe this toy"></textarea>
                            <span asp-validation-for="Description"
                                  class="text-danger"></span>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <h2 class="h5 mb-3">Toy details</h2>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ToyType" class="form-label">
                                Toy type
                            </label>
                            <input asp-for="ToyType"
                                   class="form-control"
                                   placeholder="For example, Construction Set" />
                            <span asp-validation-for="ToyType"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="RecommendedAge" class="form-label">
                                Recommended age
                            </label>
                            <input asp-for="RecommendedAge"
                                   class="form-control"
                                   placeholder="For example, 6-10 years" />
                            <span asp-validation-for="RecommendedAge"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Manufacturer" class="form-label"></label>
                            <input asp-for="Manufacturer"
                                   class="form-control"
                                   placeholder="Manufacturer name" />
                            <span asp-validation-for="Manufacturer"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Material" class="form-label"></label>
                            <input asp-for= "Material"
                                   class="form-control"
                                   placeholder="For example, Recycled Plastic" />
                            <span asp-validation-for="Material"
                                  class="text-danger"></span>
                        </div>
                    </div>

                    <div class="alert alert-info mt-4 mb-0">
                        New toys are automatically recorded as
                        <strong>Available</strong> with today’s date.
                    </div>

                    <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            Add toy
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}