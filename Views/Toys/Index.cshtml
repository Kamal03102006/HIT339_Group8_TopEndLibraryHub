@model IEnumerable<TopEndLibraryHub.Models.Toy>
@using TopEndLibraryHub.Models

@{
    ViewData["Title"] = "Manage toys";

    var currentSearch = Context.Request.Query["searchString"].ToString();
    var currentStatus = Context.Request.Query["status"].ToString();
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="display-6 fw-semibold mb-1">Manage toys</h1>
        <p class="text-muted mb-0">
            Create, review and maintain the library’s toy collection.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Add new toy
    </a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="row g-3 align-items-end">
                <div class="col-lg-6">
                    <label for="searchString" class="form-label">
                        Search toys
                    </label>

                    <input id="searchString"
                           name="searchString"
                           value="@currentSearch"
                           class="form-control"
                           placeholder="Title, code, type, age or manufacturer" />
                </div>

                <div class="col-md-6 col-lg-3">
                    <label for="status" class="form-label">
                        Item status
                    </label>

                    <select id="status" name="status" class="form-select">
                        <option value="">All statuses</option>

                        @foreach (var status in Enum.GetValues<ItemStatus>())
                        {
                            if (currentStatus == status.ToString())
                            {
                                <option value="@status" selected>@status</option>
                            }
                            else
                            {
                                <option value="@status">@status</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="d-flex gap-2">
                        <button type="submit"
                                class="btn btn-dark flex-grow-1">
                            Search
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Reset
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body py-5 text-center">
            <h2 class="h5">No toys found</h2>
            <p class="text-muted mb-3">
                Try changing the search criteria or add a new toy.
            </p>

            <a asp-action="Create" class="btn btn-primary">
                Add new toy
            </a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Library code</th>
                        <th>Toy</th>
                        <th>Type</th>
                        <th>Recommended age</th>
                        <th>Manufacturer</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var toy in Model)
                    {
                        var statusClass = toy.Status switch
                        {
                            ItemStatus.Available => "bg-success",
                            ItemStatus.Borrowed => "bg-primary",
                            ItemStatus.Damaged => "bg-warning text-dark",
                            ItemStatus.Destroyed => "bg-danger",
                            _ => "bg-secondary"
                        };

                        var description = toy.Description ?? string.Empty;

                        var summary = description.Length > 85
                            ? description.Substring(0, 85) + "…"
                            : description;

                        <tr>
                            <td class="fw-semibold">
                                @toy.LibraryCode
                            </td>

                            <td>
                                <div class="fw-semibold">@toy.Name</div>
                                <small class="text-muted">@summary</small>
                            </td>

                            <td>@toy.ToyType</td>
                            <td>@toy.RecommendedAge</td>
                            <td>@toy.Manufacturer</td>

                            <td>
                                <span class="badge @statusClass">
                                    @toy.Status
                                </span>
                            </td>

                            <td class="text-end text-nowrap">
                                <div class="btn-group">
                                    <a asp-action="Details"
                                       asp-route-id="@toy.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@toy.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@toy.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}