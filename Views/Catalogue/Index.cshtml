@model TopEndLibraryHub.ViewModels.CatalogueViewModel
@using TopEndLibraryHub.Models

@{
    ViewData["Title"] = "Search the catalogue";
}

<section class="bg-light border rounded-4 p-4 p-lg-5 mb-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <span class="badge text-bg-primary mb-3">
                Public catalogue
            </span>

            <h1 class="display-5 fw-semibold mb-3">
                Discover the collection
            </h1>

            <p class="lead text-muted mb-0">
                Search books, music and toys and check their current
                availability before visiting the library.
            </p>
        </div>

        <div class="col-lg-4">
            <div class="bg-white border rounded-4 p-4 shadow-sm">
                <div class="row text-center">
                    <div class="col-6 border-end">
                        <div class="fs-2 fw-semibold">
                            @Model.ResultCount
                        </div>
                        <small class="text-muted">Results</small>
                    </div>

                    <div class="col-6">
                        <div class="fs-2 fw-semibold text-success">
                            @Model.AvailableCount
                        </div>
                        <small class="text-muted">Available</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <form asp-controller="Catalogue"
              asp-action="Index"
              method="get">

            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-5">
                    <label for="searchString"
                           class="form-label">
                        Search the collection
                    </label>

                    <input id="searchString"
                           name="searchString"
                           value="@Model.SearchString"
                           class="form-control"
                           type="search"
                           placeholder="Title, code, author, artist or manufacturer" />
                </div>

                <div class="col-12 col-sm-6 col-lg-2">
                    <label for="itemType"
                           class="form-label">
                        Item type
                    </label>

                    <select id="itemType"
                            name="itemType"
                            class="form-select">
                        <option value="">All types</option>

                        <option value="Book"
                                selected="@(Model.SelectedType == "Book")">
                            Books
                        </option>

                        <option value="Music"
                                selected="@(Model.SelectedType == "Music")">
                            Music
                        </option>

                        <option value="Toy"
                                selected="@(Model.SelectedType == "Toy")">
                            Toys
                        </option>
                    </select>
                </div>

                <div class="col-12 col-sm-6 col-lg-2">
                    <label for="status"
                           class="form-label">
                        Item status
                    </label>

                    <select id="status"
                            name="status"
                            class="form-select">
                        <option value="">All statuses</option>

                        <option value="Available"
                                selected="@(Model.SelectedStatus == "Available")">
                            Available
                        </option>

                        <option value="Borrowed"
                                selected="@(Model.SelectedStatus == "Borrowed")">
                            Borrowed
                        </option>

                        <option value="Damaged"
                                selected="@(Model.SelectedStatus == "Damaged")">
                            Damaged
                        </option>

                        <option value="Destroyed"
                                selected="@(Model.SelectedStatus == "Destroyed")">
                            Destroyed
                        </option>
                    </select>
                </div>

                <div class="col-12 col-lg-3">
                    <div class="d-flex gap-2">
                        <button type="submit"
                                class="btn btn-primary flex-grow-1">
                            Search
                        </button>

                        <a asp-controller="Catalogue"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Reset
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="d-flex flex-column flex-sm-row justify-content-between gap-2 mb-3">
    <h2 class="h4 mb-0">Catalogue results</h2>

    <span class="text-muted">
        @Model.ResultCount
        item@(Model.ResultCount == 1 ? "" : "s") found
    </span>
</div>

@if (Model.Items.Count == 0)
{
    <div class="text-center border rounded-4 bg-light p-5">
        <h2 class="h4">No matching items found</h2>
        <p class="text-muted mb-3">
            Try a different search term or remove one of the filters.
        </p>

        <a asp-controller="Catalogue"
           asp-action="Index"
           class="btn btn-outline-primary">
            Clear search
        </a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model.Items)
        {
            var itemType = item switch
            {
                Book => "Book",
                Music => "Music",
                Toy => "Toy",
                _ => "Library item"
            };

            var statusClass = item.Status switch
            {
                ItemStatus.Available => "text-bg-success",
                ItemStatus.Borrowed => "text-bg-primary",
                ItemStatus.Damaged => "text-bg-warning",
                ItemStatus.Destroyed => "text-bg-dark",
                _ => "text-bg-secondary"
            };

            <div class="col-12 col-md-6 col-xl-4">
                <article class="card border-0 shadow-sm h-100">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <span class="badge text-bg-light border text-dark">
                                    @itemType
                                </span>

                                <div class="small text-muted mt-2">
                                    @item.LibraryCode
                                </div>
                            </div>

                            <span class="badge @statusClass">
                                @item.Status
                            </span>
                        </div>

                        <h3 class="h5 fw-semibold">
                            @item.Name
                        </h3>

                        <p class="text-muted">
                            @item.Description
                        </p>

                        <div class="border-top pt-3 mt-auto">
                            @if (item is Book book)
                            {
                                <dl class="row small mb-0">
                                    <dt class="col-5">Author</dt>
                                    <dd class="col-7">@book.Author</dd>

                                    <dt class="col-5">Genre</dt>
                                    <dd class="col-7">@book.BookGenre</dd>

                                    <dt class="col-5">Year</dt>
                                    <dd class="col-7">@book.PublicationYear</dd>
                                </dl>
                            }
                            else if (item is Music music)
                            {
                                <dl class="row small mb-0">
                                    <dt class="col-5">Artist</dt>
                                    <dd class="col-7">@music.Artist</dd>

                                    <dt class="col-5">Genre</dt>
                                    <dd class="col-7">@music.MusicGenre</dd>

                                    <dt class="col-5">Format</dt>
                                    <dd class="col-7">@music.Format</dd>

                                    <dt class="col-5">Year</dt>
                                    <dd class="col-7">@music.ReleaseYear</dd>
                                </dl>
                            }
                            else if (item is Toy toy)
                            {
                                <dl class="row small mb-0">
                                    <dt class="col-5">Type</dt>
                                    <dd class="col-7">@toy.ToyType</dd>

                                    <dt class="col-5">Age</dt>
                                    <dd class="col-7">@toy.RecommendedAge</dd>

                                    <dt class="col-5">Manufacturer</dt>
                                    <dd class="col-7">
                                        @(toy.Manufacturer ?? "Not provided")
                                    </dd>
                                </dl>
                            }
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}