@model TopEndLibraryHub.ViewModels.CreateTransferViewModel

@{
    ViewData["Title"] = "Dispatch transfer";
}

<h1>Dispatch transfer</h1>

<p>
    <strong>Origin:</strong> @Model.OriginLocation
</p>

<p>
    Select an available item at this branch and its destination.
    Saving dispatches the item immediately.
</p>

<form asp-controller="Transfers"
      asp-action="Create"
      method="post">

    <div asp-validation-summary="All"
         class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="ItemId" class="form-label"></label>
        <select asp-for="ItemId"
                asp-items="Model.Items"
                class="form-select">
            <option value="">Select an item</option>
        </select>
        <span asp-validation-for="ItemId"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DestinationBranchId"
               class="form-label"></label>
        <select asp-for="DestinationBranchId"
                asp-items="Model.DestinationBranches"
                class="form-select">
            <option value="">Select a destination</option>
        </select>
        <span asp-validation-for="DestinationBranchId"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Create and dispatch transfer
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}