@model IEnumerable<TopEndLibraryHub.Models.Loan>

@{
    ViewData["Title"] = "Loan records";
    var currentSearch = Context.Request.Query["searchString"].ToString();
    var today = DateTime.UtcNow.Date;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="display-6 fw-semibold mb-1">Loan records</h1>
        <p class="text-muted mb-0">
            Manage borrowing, returns and outstanding fines.
        </p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Borrow" class="btn btn-primary">
            Borrow item
        </a>
        <a asp-action="Return" class="btn btn-outline-primary">
            Return item
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="row g-3 align-items-end">
                <div class="col-lg-6">
                    <label for="searchString" class="form-label">
                        Search loan records
                    </label>
                    <input id="searchString"
                           name="searchString"
                           value="@currentSearch"
                           class="form-control"
                           placeholder="Item code, title, member number or name" />
                </div>

                <div class="col-md-6 col-lg-3">
                    <label for="loanStatus" class="form-label">
                        Loan status
                    </label>
                    <select id="loanStatus"
                            name="loanStatus"
                            class="form-select">
                        <option value="">All loans</option>
                        <option value="active">Active</option>
                        <option value="overdue">Overdue</option>
                        <option value="returned">Returned</option>
                        <option value="unpaid">Unpaid fines</option>
                    </select>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="d-flex gap-2">
                        <button type="submit"
                                class="btn btn-dark flex-grow-1">
                            Search
                        </button>
                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Reset
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <h2 class="h5">No loan records found</h2>
            <p class="text-muted mb-3">
                Start by borrowing an available library item.
            </p>
            <a asp-action="Borrow" class="btn btn-primary">
                Borrow item
            </a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Item</th>
                        <th>Borrower</th>
                        <th>Borrowed</th>
                        <th>Due</th>
                        <th>Fine</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var loan in Model)
                    {
                        var isReturned = loan.ReturnedDate != null;
                        var isOverdue = !isReturned &&
                            loan.DueDate.Date < today;

                        var statusText = isReturned
                            ? "Returned"
                            : isOverdue
                                ? "Overdue"
                                : "Active";

                        var statusClass = isReturned
                            ? "bg-secondary"
                            : isOverdue
                                ? "bg-danger"
                                : "bg-primary";

                        <tr>
                            <td>
                                <div class="fw-semibold">@loan.Item.Name</div>
                                <small class="text-muted">
                                    @loan.Item.LibraryCode
                                </small>
                            </td>

                            <td>
                                <div>@loan.Borrower.FullName</div>
                                <small class="text-muted">
                                    @loan.Borrower.MembershipNumber
                                </small>
                            </td>

                            <td>@loan.BorrowedDate.ToString("dd MMM yyyy")</td>
                            <td>@loan.DueDate.ToString("dd MMM yyyy")</td>

                            <td>
                                @(loan.FineAmount > 0
                                    ? loan.FineAmount.ToString("C")
                                    : "None")
                            </td>

                            <td>
                                <span class="badge @statusClass">
                                    @statusText
                                </span>
                            </td>

                            <td class="text-end text-nowrap">
                                <a asp-action="Details"
                                   asp-route-id="@loan.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Details
                                </a>

                                @if (!isReturned)
                                {
                                    <a asp-action="Return"
                                       asp-route-libraryCode="@loan.Item.LibraryCode"
                                       class="btn btn-sm btn-outline-primary">
                                        Return
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}