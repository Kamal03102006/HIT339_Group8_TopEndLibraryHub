@model TopEndLibraryHub.ViewModels.BorrowItemViewModel

@{
    ViewData["Title"] = "Borrow item";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
            <div>
                <h1 class="display-6 fw-semibold mb-1">Borrow item</h1>
                <p class="text-muted mb-0">
                    Create a loan using the item code and borrower membership number.
                </p>
            </div>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Loan records
            </a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Borrow" method="post">
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="LibraryCode" class="form-label"></label>
                        <input asp-for="LibraryCode"
                               class="form-control form-control-lg text-uppercase"
                               placeholder="For example, BK-0001"
                               autofocus />
                        <span asp-validation-for="LibraryCode"
                              class="text-danger"></span>
                        <div class="form-text">
                            The item must exist and have Available status.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MembershipNumber"
                               class="form-label"></label>
                        <input asp-for="MembershipNumber"
                               class="form-control form-control-lg text-uppercase"
                               placeholder="For example, MBR-0001" />
                        <span asp-validation-for="MembershipNumber"
                              class="text-danger"></span>
                        <div class="form-text">
                            The borrower must have an active membership.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DueDate" class="form-label"></label>
                        <input asp-for="DueDate"
                               class="form-control form-control-lg" />
                        <span asp-validation-for="DueDate"
                              class="text-danger"></span>
                        <div class="form-text">
                            The standard borrowing period is 14 days.
                        </div>
                    </div>

                    <div class="alert alert-info">
                        Item availability, active membership and duplicate
                        active loans are checked before the loan is created.
                    </div>

                    <div class="d-flex flex-column flex-sm-row gap-2">
                        <button type="submit" class="btn btn-primary">
                            Confirm borrowing
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}