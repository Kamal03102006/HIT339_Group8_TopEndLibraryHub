@model TopEndLibraryHub.Models.Book
@using TopEndLibraryHub.Models

@{
    ViewData["Title"] = "Book Details";

    var statusClass = Model.Status switch
    {
        ItemStatus.Available => "text-bg-success",
        ItemStatus.Borrowed => "text-bg-primary",
        ItemStatus.Damaged => "text-bg-warning",
        ItemStatus.Destroyed => "text-bg-danger",
        _ => "text-bg-secondary"
    };
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="d-flex flex-column flex-md-row
                justify-content-between align-items-md-center
                gap-3 mb-4">
                <div>
                    <h1 class="h2 mb-1">@Model.Name</h1>
                    <p class="text-muted mb-0">
                        Complete book and catalogue information
                    </p>
                </div>

                <span class="badge @statusClass fs-6">
                    @Model.Status
                </span>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Library code</dt>
                        <dd class="col-sm-8">@Model.LibraryCode</dd>

                        <dt class="col-sm-4">Author</dt>
                        <dd class="col-sm-8">@Model.Author</dd>

                        <dt class="col-sm-4">Genre</dt>
                        <dd class="col-sm-8">@Model.BookGenre</dd>

                        <dt class="col-sm-4">ISBN</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.Isbn)
                                ? "Not provided"
                                : Model.Isbn)
                        </dd>

                        <dt class="col-sm-4">Publication year</dt>
                        <dd class="col-sm-8">@Model.PublicationYear</dd>

                        <dt class="col-sm-4">Publisher</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.Publisher)
                                ? "Not provided"
                                : Model.Publisher)
                        </dd>

                        <dt class="col-sm-4">Date added</dt>
                        <dd class="col-sm-8">
                            @Model.DateAdded.ToString("dd MMMM yyyy")
                        </dd>

                        <dt class="col-sm-4">Description</dt>
                        <dd class="col-sm-8">@Model.Description</dd>
                    </dl>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    Edit book
                </a>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back to books
                </a>

                <a asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-danger ms-auto">
                    Delete
                </a>
            </div>
        </div>
    </div>
</div>